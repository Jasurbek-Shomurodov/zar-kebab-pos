{
  "functions": {
    "api/telegram/webhook.js": {
      "excludeFiles": "node_modules/notosans-fontface/fonts/*.{eot,svg,woff,woff2}"
    },
    "api/telegram/employee-notification.js": {
      "includeFiles": "{node_modules/@img/sharp-libvips-linux-x64/**,node_modules/notosans-fontface/fonts/*.ttf}",
      "excludeFiles": "node_modules/notosans-fontface/fonts/*.{eot,svg,woff,woff2}"
    },
    "api/telegram/daily-salary.js": {
      "includeFiles": "{node_modules/@img/sharp-libvips-linux-x64/**,node_modules/notosans-fontface/fonts/*.ttf}",
      "excludeFiles": "node_modules/notosans-fontface/fonts/*.{eot,svg,woff,woff2}"
    },
    "api/assistant/index.js": {
      "maxDuration": 120
    },
    "api/google-reviews/run.js": {
      "maxDuration": 300,
      "includeFiles": "{node_modules/@img/sharp-libvips-linux-x64/**,node_modules/notosans-fontface/fonts/*.ttf}",
      "excludeFiles": "node_modules/notosans-fontface/fonts/*.{eot,svg,woff,woff2}"
    }
  },
  "crons": [
    {
      "path": "/api/telegram/daily-salary?task=unavailable-products",
      "schedule": "0 3 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "zar-kebab.vercel.app"
        }
      ],
      "destination": "https://www.zarkebab.uz/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "zar-kebab-pos.vercel.app"
        }
      ],
      "destination": "https://www.zarkebab.uz/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/sb/rest/v1/:path*", "destination": "https://bcdbljpwhyawaasimjmk.supabase.co/rest/v1/:path*" },
    { "source": "/yandex-menu.yml", "destination": "/api/google-reviews/run?task=yandex-feed" },
    { "source": "/yandex-photos/:file", "destination": "/api/google-reviews/run?task=yandex-photo&file=:file" },
    { "source": "/((?!api/|sb/).*)", "destination": "/index.html" }
  ]
}
